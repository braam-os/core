# What `help` prints for each program in /bin: one `name  usage` line, the
# name first and the rest of the line its one-line usage. A binary the file
# does not mention still lists, without a usage — the listing comes from the
# directory, and this only decorates it.
#
# It lives here rather than in the kernel because a program is a file now, and
# the kernel has no usage string for one it has never run.
cat      [<file>...] — copy files, or the input, to the output
chat     <url> [<nick>] — talk over a WebSocket to whoever else is there
clear    blank the screen
curl     [-i] [-X <method>] [-H <header>] [-d <data>] <url> — fetch a URL
date     [-u] — print the date and time
df       [-h] — report filesystem space, and with -h in scaled units
echo     [-n] [word...] — write the arguments
edit     <file> — a full-screen editor; ^S saves, ^Q quits
export   <file> [<name>] — download a file out of the browser
false    fail
grep     [-i] [-v] <text> [<file>...] — pass matching lines
head     [-n <count>] [<file>...] — the first lines, ten by default
hog      take memory until the cap refuses more
import   [<dir>] — copy files from the browser into /mnt/import
less     [<file>] — page through a file, or the input; q quits
ls       [-1CRSdhlr] [<path>...] — list directories, in columns on a terminal
mkdir    <dir>... — create directories
mount    list the mounted filesystems
pbcopy   [<file>...] — put the input on the clipboard
pbpaste  write the clipboard to the output
ps       list the tasks the kernel is running, and which hold a worker
pwd      print the working directory
rm       [-r] <path>... — remove files, or directories with -r
sh       [-s] — the shell; -s reads stdin instead of drawing a prompt
sleep    <ms> — wait, in milliseconds
spin     [<millions>] — loop without yielding, to be killed
tail     [-n <count>] [<file>...] — the last lines, ten by default
timeout  <ms> <command> [<arg>...] — run a command, killing it after a delay (124)
touch    <file>... — create empty files
true     succeed
uname    [-a|-s|-r|-m] — name the system, and with -a the host it runs on
vmstat   [-s] [<secs> [<count>]] — report what the kernel is doing, as rates
watch    [-n <ms>] <command> [<arg>...] — run a command over and over
wc       [<file>...] — count lines, words and bytes
